{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:uran:framework:deployment:release-lock:1.0",
  "title": "Immutable whole-release lock",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "release_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "profile_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "profile_version": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "api_version": {
      "const": "2.1"
    },
    "native_abi": {
      "const": 3
    },
    "state_schema": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "platform": {
      "type": "object",
      "properties": {
        "os": {
          "const": "Linux"
        },
        "arch": {
          "type": "string",
          "minLength": 1
        },
        "os_version": {
          "type": "string",
          "minLength": 1
        },
        "libc": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 2,
          "maxItems": 2
        },
        "python": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+$"
        },
        "distribution": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "os",
        "arch"
      ],
      "additionalProperties": false
    },
    "host": {
      "type": "string",
      "minLength": 1
    },
    "runtime_config": {
      "type": "string",
      "minLength": 1
    },
    "packages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "package": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "origin": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "package",
          "version",
          "origin",
          "sha256"
        ],
        "additionalProperties": false
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "size": {
            "type": "integer",
            "minimum": 0
          },
          "executable": {
            "type": "boolean"
          }
        },
        "required": [
          "path",
          "sha256",
          "size",
          "executable"
        ],
        "additionalProperties": false
      }
    },
    "services": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
          },
          "command": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "depends_on": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
            }
          },
          "healthcheck": {
            "type": "object",
            "properties": {
              "command": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "timeout_s": {
                "type": "integer",
                "minimum": 1,
                "maximum": 300
              }
            },
            "required": [
              "command",
              "timeout_s"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "command",
          "depends_on",
          "healthcheck"
        ],
        "additionalProperties": false
      }
    },
    "preflight": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "command": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "timeout_s": {
            "type": "integer",
            "minimum": 1,
            "maximum": 300
          }
        },
        "required": [
          "command",
          "timeout_s"
        ],
        "additionalProperties": false
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "command": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "timeout_s": {
            "type": "integer",
            "minimum": 1,
            "maximum": 300
          }
        },
        "required": [
          "command",
          "timeout_s"
        ],
        "additionalProperties": false
      }
    },
    "migration": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "from_schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
            },
            "strategy": {
              "const": "snapshot"
            },
            "command": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "timeout_s": {
              "type": "integer",
              "minimum": 1,
              "maximum": 300
            }
          },
          "required": [
            "from_schema",
            "strategy",
            "command",
            "timeout_s"
          ],
          "additionalProperties": false
        }
      ]
    },
    "post_activate": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "command": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "timeout_s": {
            "type": "integer",
            "minimum": 1,
            "maximum": 300
          }
        },
        "required": [
          "command",
          "timeout_s"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "release_id",
    "profile_id",
    "profile_version",
    "api_version",
    "native_abi",
    "state_schema",
    "platform",
    "host",
    "runtime_config",
    "packages",
    "files",
    "services",
    "preflight",
    "checks",
    "migration",
    "post_activate"
  ],
  "additionalProperties": false
}
